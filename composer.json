{
    "name": "webyashopy/laravel-ai-chatbot",
    "description": "Znovupoužitelný AI chatbot (Anthropic Claude) pro Laravel — AI klient, usage logging, per-user klíče, agentní tool-loop.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Petr Kalous"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0",
        "inertiajs/inertia-laravel": "^2.0|^3.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Webyashopy\\Chatbot\\": "src/",
            "Webyashopy\\Chatbot\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webyashopy\\Chatbot\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webyashopy\\Chatbot\\ChatbotServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
